# Copy to .env on the computer that will run Nandi. Never commit .env.
NANDI_AUTH_USERNAME=YOUR_PRIVATE_USERNAME
NANDI_AUTH_PASSWORD=YOUR_STRONG_PASSWORD
UPSTOX_ACCESS_TOKEN=YOUR_READ_ONLY_ANALYTICS_TOKEN

# Nandi only analyses during the regular NSE equity-derivatives session.
NANDI_CAPTURE_SECONDS=30
# Comma-separated official NSE trading holidays, for example: 2026-01-26,2026-03-04
NANDI_NSE_HOLIDAYS=

# Optional: endpoint accepting JSON with title, message, and level.
NANDI_ALERT_WEBHOOK_URL=
