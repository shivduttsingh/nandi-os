# Copy to .env only for local/private deployments. Never commit real secrets.
NANDI_AUTH_USERNAME=YOUR_PRIVATE_USERNAME
NANDI_AUTH_PASSWORD=YOUR_STRONG_PASSWORD

# Browser-independent Nandi cloud worker.
# Logical worker window is 08:55-16:00 Asia/Kolkata on trading weekdays.
NANDI_NSE_OI_REFRESH_SECONDS=30
NANDI_NSE_SPOT_REFRESH_SECONDS=3
NANDI_IDLE_SLEEP_SECONDS=30
NANDI_TRADE_THRESHOLD=75
NANDI_EMAIL_THRESHOLD=80
NANDI_CONFIRMATION_SNAPSHOTS=2
NANDI_DB_PATH=data/nandi_v2.sqlite
# Comma-separated official NSE holidays in YYYY-MM-DD form.
NANDI_NSE_HOLIDAYS=

# SMTP alert configuration. Store real values in the cloud provider's secret manager.
NANDI_SMTP_HOST=smtp.gmail.com
NANDI_SMTP_PORT=587
NANDI_SMTP_USERNAME=YOUR_NANDI_GMAIL
NANDI_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
NANDI_ALERT_SENDER=YOUR_NANDI_GMAIL
NANDI_ALERT_RECIPIENT=YOUR_PERSONAL_ALERT_EMAIL
NANDI_SMTP_USE_TLS=true

# Streamlit Community Cloud alone is not an unattended worker. For browser-independent
# monitoring, deploy cloud_service.py/Procfile on an always-on service and use persistent
# storage for NANDI_DB_PATH if history must survive container replacement.
