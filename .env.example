# Copy to .env on the computer that will run Nandi. Never commit .env.
NANDI_AUTH_USERNAME=YOUR_PRIVATE_USERNAME
NANDI_AUTH_PASSWORD=YOUR_STRONG_PASSWORD

# NSE public-adapter refresh controls. The Streamlit UI recalculates every second,
# while network calls are deliberately rate-limited. Use an authorised NSE Data
# feed for production-grade or licensed real-time deployment.
NANDI_NSE_OI_REFRESH_SECONDS=60
NANDI_NSE_SPOT_REFRESH_SECONDS=5

# Optional SMTP alert configuration for confirmed 80+ entry setups.
NANDI_SMTP_HOST=
NANDI_SMTP_PORT=587
NANDI_SMTP_USERNAME=
NANDI_SMTP_PASSWORD=
NANDI_ALERT_SENDER=
NANDI_ALERT_RECIPIENT=
NANDI_SMTP_USE_TLS=true

# Streamlit Cloud users should place the equivalent values in Streamlit Secrets.
# Add NSE holidays there under [nse].holidays so the live signal gate is closed
# on exchange holidays as well as weekends and out-of-session hours.
