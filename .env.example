# ATLAS local worker configuration. Copy to .env; never commit the real file.
# Read-only Upstox Analytics API access token (never an order-enabled token).
UPSTOX_ACCESS_TOKEN=PASTE_READ_ONLY_UPSTOX_ACCESS_TOKEN_HERE

# NIFTY option-chain capture cadence; minimum enforced by worker is 10 seconds.
NANDI_CAPTURE_SECONDS=30
NANDI_DB_PATH=/app/data/atlas.db
NANDI_LOG_LEVEL=INFO

# NSE trading holidays, comma-separated YYYY-MM-DD.
NANDI_NSE_HOLIDAYS=

# Optional alert webhook. Leave blank to keep alerts only in the local database.
NANDI_ALERT_WEBHOOK_URL=

# Optional Streamlit app authentication (only if the existing auth layer is enabled).
NANDI_AUTH_USERNAME=
NANDI_AUTH_PASSWORD=

# Streamlit Cloud users should put the token in App Settings > Secrets:
# UPSTOX_ACCESS_TOKEN = "your_read_only_token"
# Never put secrets in source code, screenshots, GitHub commits or browser JavaScript.
